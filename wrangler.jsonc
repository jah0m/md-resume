{
  "name": "md-resume",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [{ "pattern": "md-resume.jahom.dev", "custom_domain": true }],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "./dist",
    "run_worker_first": ["/api/*", "/mcp"]
  },
  // MCP generate_resume_pdf: a headless browser prints the site, the PDF is
  // kept in R2 for a 1-hour download link (bucket lifecycle deletes leftovers
  // after 1 day), and each client IP may create 5 PDFs per minute.
  "browser": { "binding": "BROWSER" },
  "r2_buckets": [{ "binding": "PDFS", "bucket_name": "md-resume-pdfs" }],
  "ratelimits": [
    {
      "name": "PDF_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  // The MCP server returns the sample resume as text.
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "md-resume-db",
      "database_id": "1ca877d8-33cf-48b4-bb2f-d0848d0cfbe0"
    }
  ]
}
