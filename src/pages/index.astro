---
import Layout from "../layouts/Layout.astro";
import "../styles/resume.css";
import sampleResume from "../data/sample-resume.md?raw";

const title = "Markdown職務経歴書 PDF変換ツール｜無料・ブラウザで完結";
const description =
  "日本の定番テンプレートでは物足りない人へ。Markdownで書いた職務経歴書を、デザイン性のあるA4レイアウトに整えてPDF保存できます。入力内容はブラウザ内だけで処理します。";
---

<Layout title={title} description={description}>
  <div class="app">
    <header class="app-header">
      <div class="header-row">
        <div class="app-title-wrap">
          <div class="brand-lockup">
            <img class="brand-mark" src="/favicon.svg" alt="" aria-hidden="true" />
            <div>
              <p class="eyebrow">PERSONAL RESUME STUDIO</p>
              <h1 data-i18n="brandTitle">型にはまらない、あなたの職務経歴書</h1>
            </div>
          </div>
          <p class="lede" data-i18n="lede">Markdownで書いて、自分のキャリアを自分で設計する。</p>
        </div>
        <div class="header-meta">
          <span class="privacy-note" data-i18n="privacyNote">データはブラウザ内だけで処理</span>
          <span class="header-detail" data-i18n="headerDetail">A4 / Markdown → PDF</span>
          <div
            class="language-picker"
            role="group"
            aria-label="表示言語"
            data-i18n-aria-label="languageLabel"
          >
            <div class="language-options">
              <button type="button" data-locale-option="ja" aria-pressed="true">日</button>
              <button type="button" data-locale-option="en" aria-pressed="false">EN</button>
              <button type="button" data-locale-option="zh" aria-pressed="false">中</button>
            </div>
          </div>
        </div>
      </div>
    </header>

    <div class="workspace">
      <div class="editor-pane">
        <div class="panel-heading">
          <div>
            <div class="pane-label"><span data-i18n="editorPaneLabel">原稿エディター</span> <span data-i18n="autosave">自動保存</span></div>
            <p class="panel-title" data-i18n="editorTitle">Markdownで内容を整える</p>
          </div>
          <span class="panel-index">01</span>
        </div>
        <div class="editor-toolbar">
          <div class="action-group">
            <button id="load-sample" data-i18n="loadSample">サンプル</button>
            <button id="download-sample" data-i18n="downloadSample">サンプルを保存</button>
            <label for="file-input" data-i18n="openMd">.mdを開く</label>
            <input
              id="file-input"
              type="file"
              accept=".md,text/markdown,text/plain"
            />
          </div>
          <div class="action-group action-group-secondary">
            <button id="save-md" data-i18n="saveMd">.md保存</button>
            <button id="clear-editor" data-i18n="clear">クリア</button>
          </div>
        </div>
        <div class="avatar-control">
          <div class="avatar-control-copy">
            <span class="avatar-control-label" data-i18n="profilePhoto">プロフィール写真</span>
            <span id="avatar-status">未設定</span>
          </div>
          <div class="avatar-control-actions">
            <label for="avatar-input" data-i18n="uploadImage">画像をアップロード</label>
            <button id="edit-avatar" type="button" disabled data-i18n="editPhoto">写真を編集</button>
            <button id="clear-avatar" type="button" disabled data-i18n="removePhoto">取り除く</button>
            <input id="avatar-input" type="file" accept="image/*" />
          </div>
        </div>
        <dialog
          id="avatar-editor"
          class="avatar-editor"
          aria-labelledby="avatar-editor-title"
        >
          <div class="avatar-editor-heading">
            <div>
              <span class="avatar-editor-kicker" data-i18n="photoKicker">PROFILE PHOTO</span>
              <h3 id="avatar-editor-title" data-i18n="editPhotoTitle">写真を整える</h3>
            </div>
            <button
              id="close-avatar-editor"
              class="avatar-editor-close"
              type="button"
              aria-label="写真編集を閉じる"
              data-i18n="close"
              data-i18n-aria-label="closePhotoEditor">閉じる</button
            >
          </div>
          <div class="avatar-editor-body">
            <div
              class="avatar-editor-stage"
              id="avatar-editor-stage"
              tabindex="0"
              role="application"
              aria-label="写真をドラッグして位置を調整。ホイールで拡大縮小"
              data-i18n-aria-label="adjustPhoto"
            >
              <img
                id="avatar-editor-source-image"
                class="avatar-editor-source-image"
                alt=""
                aria-hidden="true"
              />
              <div
                class="avatar-crop-frame avatar-editor-crop-window"
                id="avatar-editor-crop-window"
                data-shape="square"
              >
                <img
                  id="avatar-editor-image"
                  alt="プロフィール写真の編集プレビュー"
                  data-i18n-alt="photoPreviewAlt"
                />
              </div>
            </div>
            <div class="avatar-editor-settings">
              <label class="avatar-zoom-control" for="avatar-zoom">
                <span
                  ><span data-i18n="zoom">拡大率</span> <output id="avatar-zoom-value" for="avatar-zoom"
                    >100%</output
                  ></span
                >
                <input
                  id="avatar-zoom"
                  type="range"
                  min="100"
                  max="240"
                  step="1"
                  value="100"
                />
              </label>
              <fieldset class="avatar-shape-control">
                <legend data-i18n="displayShape">表示形状</legend>
                <div class="avatar-shape-options">
                  <label>
                    <input
                      type="radio"
                      name="avatar-shape"
                      value="square"
                      checked
                    />
                    <span data-i18n="square">方形</span>
                  </label>
                  <label>
                    <input type="radio" name="avatar-shape" value="circle" />
                    <span data-i18n="circle">円形</span>
                  </label>
                </div>
              </fieldset>
              <p class="avatar-editor-note">
                <span data-i18n="photoEditorNote">ドラッグで位置調整、スクロールで拡大縮小。変更内容は「保存」でプレビューに反映されます。</span>
              </p>
            </div>
          </div>
          <div class="avatar-editor-actions">
            <button
              id="cancel-avatar-editor"
              class="avatar-editor-secondary"
              type="button" data-i18n="cancel">キャンセル</button
            >
            <button
              id="save-avatar-editor"
              class="avatar-editor-primary"
              type="button" data-i18n="save">保存</button
            >
          </div>
        </dialog>
        <textarea
          id="markdown-input"
          spellcheck="false"
          aria-label="Markdown入力"
          data-i18n-aria-label="editorInput"></textarea>
      </div>
      <div class="preview-pane">
        <div class="panel-heading">
          <div>
            <div class="pane-label">
              <span data-i18n="previewLabel">プレビュー</span>
              <span id="page-count">A4 / Professional</span>
            </div>
            <p class="panel-title" data-i18n="previewTitle">職務経歴書の仕上がり</p>
          </div>
          <div class="preview-actions">
            <div class="theme-picker" role="group" aria-label="履歴書テーマ" data-i18n-aria-label="theme">
              <span data-i18n="theme">テーマ</span>
              <div class="theme-dots">
                <button
                  type="button"
                  class="theme-dot"
                  data-theme-option="navy"
                  aria-label="クラシック・ネイビー"
                  data-i18n-aria-label="themeNavy"
                  aria-pressed="false"></button>
                <button
                  type="button"
                  class="theme-dot"
                  data-theme-option="graphite"
                  aria-label="ミニマル・グラファイト"
                  data-i18n-aria-label="themeGraphite"
                  aria-pressed="false"></button>
                <button
                  type="button"
                  class="theme-dot"
                  data-theme-option="slate"
                  aria-label="スレート・ブルー"
                  data-i18n-aria-label="themeSlate"
                  aria-pressed="false"></button>
                <button
                  type="button"
                  class="theme-dot"
                  data-theme-option="forest"
                  aria-label="フォレスト・グリーン"
                  data-i18n-aria-label="themeForest"
                  aria-pressed="false"></button>
                <button
                  type="button"
                  class="theme-dot"
                  data-theme-option="burgundy"
                  aria-label="ワイン・バーガンディ"
                  data-i18n-aria-label="themeBurgundy"
                  aria-pressed="false"></button>
                <button
                  type="button"
                  class="theme-dot"
                  data-theme-option="amber"
                  aria-label="ウォーム・アンバー"
                  data-i18n-aria-label="themeAmber"
                  aria-pressed="false"></button>
              </div>
            </div>
            <div
              class="background-picker"
              role="group"
              aria-label="履歴書の背景"
              data-i18n-aria-label="background"
            >
              <span data-i18n="background">背景</span>
              <div class="theme-dots">
                <button
                  type="button"
                  class="theme-dot background-dot"
                  data-background-option="paper"
                  aria-label="ピュア・ホワイト"
                  data-i18n-aria-label="backgroundPaper"
                  aria-pressed="false"></button>
                <button
                  type="button"
                  class="theme-dot background-dot"
                  data-background-option="mist"
                  aria-label="クール・ミスト"
                  data-i18n-aria-label="backgroundMist"
                  aria-pressed="false"></button>
                <button
                  type="button"
                  class="theme-dot background-dot"
                  data-background-option="linen"
                  aria-label="ソフト・リネン"
                  data-i18n-aria-label="backgroundLinen"
                  aria-pressed="false"></button>
              </div>
            </div>
            <button id="save-pdf" class="primary" data-i18n="savePdf">PDFとして保存</button>
          </div>
        </div>
        <div class="preview-scroll">
          <article
            id="resume-preview"
            aria-label="職務経歴書プレビュー"
            data-i18n-aria-label="resumePreview"
          >
            <div id="resume-pages"></div>
          </article>
        </div>
      </div>
      <section class="usage-section">
        <h2 data-i18n="aboutTitle">このツールについて</h2>
        <p data-i18n="aboutText">
          日本の定番テンプレートでは表現しにくい、自分らしさとキャリアの個性を、Markdownから自分で組み立てられる職務経歴書に。
          入力した内容はデザイン性のあるA4レイアウトに整形され、サーバーに送信されることなくブラウザ内で処理されます。
        </p>
        <h2 data-i18n="howToTitle">使い方</h2>
        <ol>
          <li data-i18n="howToStep1">
            「サンプルを読み込む」でMarkdownの書き方を確認するか、お手持ちの.mdファイルを開きます。
          </li>
          <li data-i18n="howToStep2">
            左側のエディタで内容を編集すると、右側のプレビューにリアルタイムで反映されます。
          </li>
          <li data-i18n="howToStep3">
            「PDFとして保存」を押すと印刷ダイアログが開きます。出力先を「PDFに保存」にして保存すれば完了です。
          </li>
          <li data-i18n="howToStep4">
            お手持ちの履歴書をAIに渡し、「このサンプルの見出しと構成に合わせて整理して」と依頼することもできます。個人情報を含む内容を外部AIへ送信する場合は、利用するサービスの設定を確認してください。
          </li>
        </ol>
        <div class="usage-ai-prompt">
          <strong data-i18n="aiPromptTitle">AIで職務経歴書を整える</strong>
          <p data-i18n="aiPrompt">
            このサンプルの見出しと構成に合わせて、私の職務経歴書をMarkdownとして整理してください。内容は変更せず、情報が足りない部分は「〇〇」などのプレースホルダーにしてください。
          </p>
        </div>
        <div class="usage-contact-tip">
          <strong data-i18n="contactTitle">連絡先の書き方</strong>
          <p data-i18n-html="contactHelp">
            名前の直後に1行で記述すると、タイトル下に表示されます。<strong>PhoneとEmail</strong>はテキスト、<strong>LinkedIn・GitHub・Portfolio・個人サイト・SNS</strong>などはMarkdownリンクにします。
          </p>
        </div>
        <h2 data-i18n="syntaxTitle">対応記法</h2>
        <p data-i18n="syntaxText">
          見出し（# ##
          ###）、箇条書き、表、太字などの標準的なMarkdown記法に対応しています。
        </p>
        <footer class="site-footer">
          <a href="https://github.com/jah0m" target="_blank" rel="noreferrer">© Jahom</a>
        </footer>
      </section>
    </div>
  </div>

  <script type="text/plain" id="sample-resume-data" set:html={sampleResume} />

  <script>
    import { renderMarkdown } from "../lib/markdown";
    import {
      getInitialLocale,
      isLocale,
      LOCALE_KEY,
      translate,
      type Locale,
      type MessageKey,
    } from "../lib/i18n";

    const STORAGE_KEY = "md-resume-content-v2";
    const THEME_KEY = "md-resume-theme";
    const BACKGROUND_KEY = "md-resume-background";
    const AVATAR_KEY = "md-resume-avatar";
    const AVATAR_DEFAULT_DISMISSED_KEY = "md-resume-avatar-default-dismissed";

    const textarea = document.getElementById(
      "markdown-input",
    ) as HTMLTextAreaElement;
    const preview = document.getElementById("resume-preview") as HTMLElement;
    const previewScroll = document.querySelector(
      ".preview-scroll",
    ) as HTMLElement;
    const pages = document.getElementById("resume-pages") as HTMLElement;
    const pageCount = document.getElementById("page-count") as HTMLElement;
    const themeButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-theme-option]"),
    );
    const backgroundButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>(
        "[data-background-option]",
      ),
    );
    const localeButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-locale-option]"),
    );
    let currentLocale: Locale = getInitialLocale();
    const avatarInput = document.getElementById(
      "avatar-input",
    ) as HTMLInputElement;
    const avatarStatus = document.getElementById(
      "avatar-status",
    ) as HTMLElement;
    const editAvatarButton = document.getElementById(
      "edit-avatar",
    ) as HTMLButtonElement;
    const clearAvatarButton = document.getElementById(
      "clear-avatar",
    ) as HTMLButtonElement;
    const avatarEditor = document.getElementById(
      "avatar-editor",
    ) as HTMLDialogElement;
    const avatarEditorStage = document.getElementById(
      "avatar-editor-stage",
    ) as HTMLElement;
    const avatarEditorCropWindow = document.getElementById(
      "avatar-editor-crop-window",
    ) as HTMLElement;
    const avatarEditorSourceImage = document.getElementById(
      "avatar-editor-source-image",
    ) as HTMLImageElement;
    const avatarEditorImage = document.getElementById(
      "avatar-editor-image",
    ) as HTMLImageElement;
    const avatarZoomInput = document.getElementById(
      "avatar-zoom",
    ) as HTMLInputElement;
    const avatarZoomValue = document.getElementById(
      "avatar-zoom-value",
    ) as HTMLOutputElement;
    const avatarShapeInputs = Array.from(
      document.querySelectorAll<HTMLInputElement>('input[name="avatar-shape"]'),
    );
    const closeAvatarEditorButton = document.getElementById(
      "close-avatar-editor",
    ) as HTMLButtonElement;
    const cancelAvatarEditorButton = document.getElementById(
      "cancel-avatar-editor",
    ) as HTMLButtonElement;
    const saveAvatarEditorButton = document.getElementById(
      "save-avatar-editor",
    ) as HTMLButtonElement;
    const sampleData = document.getElementById(
      "sample-resume-data",
    ) as HTMLScriptElement;
    const sampleText = sampleData.textContent ?? "";
    const storedAvatar = localStorage.getItem(AVATAR_KEY);
    let avatarDataUrl =
      storedAvatar ??
      (localStorage.getItem(AVATAR_DEFAULT_DISMISSED_KEY) === "true"
        ? ""
        : "/demo-avatar.png");
    const AVATAR_SETTINGS_KEY = "md-resume-avatar-settings";
    const savedAvatarSettings = (() => {
      try {
        const parsed = JSON.parse(
          localStorage.getItem(AVATAR_SETTINGS_KEY) ?? "{}",
        );
        return {
          zoom: Number.isFinite(Number(parsed.zoom))
            ? Number(parsed.zoom)
            : 100,
          shape: parsed.shape === "circle" ? "circle" : "square",
          x: Number.isFinite(Number(parsed.x)) ? Number(parsed.x) : 0,
          y: Number.isFinite(Number(parsed.y)) ? Number(parsed.y) : 0,
        };
      } catch {
        return { zoom: 100, shape: "square", x: 0, y: 0 };
      }
    })();
    let avatarZoom = Math.min(240, Math.max(100, savedAvatarSettings.zoom));
    let avatarShape: "square" | "circle" = savedAvatarSettings.shape;
    let avatarOffset = {
      x: Math.min(100, Math.max(-100, savedAvatarSettings.x)),
      y: Math.min(100, Math.max(-100, savedAvatarSettings.y)),
    };
    let avatarDraftDataUrl = avatarDataUrl;
    let avatarDraftZoom = avatarZoom;
    let avatarDraftShape: "square" | "circle" = avatarShape;
    let avatarDraftOffset = { ...avatarOffset };

    function message(key: string) {
      return translate(currentLocale, key as MessageKey);
    }

    function applyLocale(locale: string) {
      const nextLocale: Locale = isLocale(locale) ? locale : "ja";
      currentLocale = nextLocale;
      document.documentElement.lang = nextLocale === "zh" ? "zh-CN" : nextLocale;
      document.documentElement.dataset.locale = nextLocale;

      document.querySelectorAll<HTMLElement>("[data-i18n]").forEach((element) => {
        element.textContent = message(element.dataset.i18n ?? "");
      });
      document.querySelectorAll<HTMLElement>("[data-i18n-html]").forEach((element) => {
        element.innerHTML = message(element.dataset.i18nHtml ?? "");
      });
      document
        .querySelectorAll<HTMLElement>("[data-i18n-aria-label]")
        .forEach((element) => {
          element.setAttribute(
            "aria-label",
            message(element.dataset.i18nAriaLabel ?? ""),
          );
        });
      document
        .querySelectorAll<HTMLImageElement>("[data-i18n-alt]")
        .forEach((element) => {
          element.alt = message(element.dataset.i18nAlt ?? "");
        });

      document.title = message("documentTitle");
      document
        .querySelector('meta[name="description"]')
        ?.setAttribute("content", message("description"));
      localeButtons.forEach((button) => {
        button.setAttribute(
          "aria-pressed",
          String(button.dataset.localeOption === nextLocale),
        );
      });
      pageCount.textContent = formatPageCount(currentPageTotal);
      updateAvatarControls();
      document.documentElement.classList.remove("i18n-pending");
      document.documentElement.style.removeProperty("visibility");
    }

    function applyTheme(theme: string) {
      const validThemes = [
        "navy",
        "graphite",
        "slate",
        "forest",
        "burgundy",
        "amber",
      ];
      const nextTheme = validThemes.includes(theme) ? theme : "navy";
      preview.dataset.theme = nextTheme;
      themeButtons.forEach((button) => {
        button.setAttribute(
          "aria-pressed",
          String(button.dataset.themeOption === nextTheme),
        );
      });
    }

    function applyBackground(background: string) {
      const validBackgrounds = ["paper", "mist", "linen"];
      const nextBackground = validBackgrounds.includes(background)
        ? background
        : "paper";
      preview.dataset.background = nextBackground;
      backgroundButtons.forEach((button) => {
        button.setAttribute(
          "aria-pressed",
          String(button.dataset.backgroundOption === nextBackground),
        );
      });
    }

    let renderToken = 0;
    let currentPageTotal = 1;

    function px(value: string) {
      const parsed = Number.parseFloat(value);
      return Number.isFinite(parsed) ? parsed : 0;
    }

    function formatCurrentDate() {
      const today = new Date();
      const year = today.getFullYear();
      const month = String(today.getMonth() + 1).padStart(2, "0");
      const day = String(today.getDate()).padStart(2, "0");
      return `${year}-${month}-${day}`;
    }

    function formatPageCount(count: number) {
      return message("pageCount").replace("{count}", String(count));
    }

    function updateAvatarControls(statusKey?: "avatarPending" | "avatarUploadFailed") {
      avatarStatus.textContent =
        statusKey
          ? message(statusKey)
          : avatarDataUrl
            ? message("avatarSet")
            : message("avatarUnset");
      editAvatarButton.disabled = !avatarDataUrl;
      clearAvatarButton.disabled = !avatarDataUrl;
    }

    function persistAvatarSettings() {
      localStorage.setItem(
        AVATAR_SETTINGS_KEY,
        JSON.stringify({
          zoom: avatarZoom,
          shape: avatarShape,
          x: avatarOffset.x,
          y: avatarOffset.y,
        }),
      );
    }

    function syncAvatarEditor() {
      avatarEditorCropWindow.dataset.shape = avatarDraftShape;
      avatarEditorCropWindow.style.setProperty(
        "--avatar-zoom",
        String(avatarDraftZoom / 100),
      );
      avatarEditorCropWindow.style.setProperty(
        "--avatar-offset-x",
        `${avatarDraftOffset.x}%`,
      );
      avatarEditorCropWindow.style.setProperty(
        "--avatar-offset-y",
        `${avatarDraftOffset.y}%`,
      );
      avatarEditorSourceImage.style.setProperty(
        "--avatar-zoom",
        String(avatarDraftZoom / 100),
      );
      avatarEditorSourceImage.style.setProperty(
        "--avatar-offset-x",
        `${avatarDraftOffset.x}%`,
      );
      avatarEditorSourceImage.style.setProperty(
        "--avatar-offset-y",
        `${avatarDraftOffset.y}%`,
      );
      avatarZoomInput.value = String(avatarDraftZoom);
      avatarZoomValue.value = `${avatarDraftZoom}%`;
      avatarShapeInputs.forEach((input) => {
        input.checked = input.value === avatarDraftShape;
      });
    }

    function setAvatarEditorOpen(
      isOpen: boolean,
      draftDataUrl = avatarDataUrl,
    ) {
      const shouldOpen = isOpen && Boolean(draftDataUrl);
      if (shouldOpen) {
        avatarDraftDataUrl = draftDataUrl;
        avatarDraftZoom = avatarZoom;
        avatarDraftShape = avatarShape;
        avatarDraftOffset = { ...avatarOffset };
        avatarEditorSourceImage.src = avatarDraftDataUrl;
        avatarEditorImage.src = avatarDraftDataUrl;
        if (!avatarEditor.open) avatarEditor.showModal();
        syncAvatarEditor();
      } else {
        if (avatarEditor.open) avatarEditor.close();
        avatarEditorSourceImage.removeAttribute("src");
        avatarEditorImage.removeAttribute("src");
        updateAvatarControls();
      }
    }

    function saveAvatarEditor() {
      if (!avatarDraftDataUrl) return;
      avatarDataUrl = avatarDraftDataUrl;
      avatarZoom = avatarDraftZoom;
      avatarShape = avatarDraftShape;
      avatarOffset = { ...avatarDraftOffset };
      localStorage.setItem(AVATAR_KEY, avatarDataUrl);
      localStorage.removeItem(AVATAR_DEFAULT_DISMISSED_KEY);
      persistAvatarSettings();
      setAvatarEditorOpen(false);
      updateAvatarControls();
      render();
    }

    function clampAvatarOffset(value: number) {
      return Math.min(100, Math.max(-100, value));
    }

    let avatarDragPointerId: number | null = null;
    let avatarDragStart = { x: 0, y: 0 };
    let avatarDragOrigin = { x: 0, y: 0 };

    function finishAvatarDrag(pointerId: number) {
      if (avatarDragPointerId !== pointerId) return;
      avatarDragPointerId = null;
      avatarEditorStage.classList.remove("is-dragging");
      if (avatarEditorStage.hasPointerCapture(pointerId)) {
        avatarEditorStage.releasePointerCapture(pointerId);
      }
    }

    avatarEditorStage.addEventListener("pointerdown", (event) => {
      if (event.button !== 0) return;
      avatarDragPointerId = event.pointerId;
      avatarDragStart = { x: event.clientX, y: event.clientY };
      avatarDragOrigin = { ...avatarDraftOffset };
      avatarEditorStage.setPointerCapture(event.pointerId);
      avatarEditorStage.classList.add("is-dragging");
      event.preventDefault();
    });

    avatarEditorStage.addEventListener("pointermove", (event) => {
      if (avatarDragPointerId !== event.pointerId) return;
      const bounds = avatarEditorStage.getBoundingClientRect();
      avatarDraftOffset = {
        x: clampAvatarOffset(
          avatarDragOrigin.x +
            ((event.clientX - avatarDragStart.x) / bounds.width) * 100,
        ),
        y: clampAvatarOffset(
          avatarDragOrigin.y +
            ((event.clientY - avatarDragStart.y) / bounds.height) * 100,
        ),
      };
      syncAvatarEditor();
      event.preventDefault();
    });

    avatarEditorStage.addEventListener("pointerup", (event) => {
      finishAvatarDrag(event.pointerId);
    });

    avatarEditorStage.addEventListener("pointercancel", (event) => {
      finishAvatarDrag(event.pointerId);
    });

    avatarEditorStage.addEventListener(
      "wheel",
      (event) => {
        const nextZoom = avatarDraftZoom + (event.deltaY < 0 ? 5 : -5);
        avatarDraftZoom = Math.min(240, Math.max(100, nextZoom));
        syncAvatarEditor();
        event.preventDefault();
      },
      { passive: false },
    );

    async function optimizeAvatar(file: File) {
      const sourceUrl = await new Promise<string>((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(String(reader.result ?? ""));
        reader.onerror = () => reject(new Error("画像を読み込めませんでした"));
        reader.readAsDataURL(file);
      });

      return new Promise<string>((resolve, reject) => {
        const image = new Image();
        image.onload = () => {
          // Keep normal photos untouched. Only very large images are reduced,
          // and the editor itself handles the visual crop inside the avatar frame.
          const maxEdge = 1600;
          const longestEdge = Math.max(image.naturalWidth, image.naturalHeight);
          if (longestEdge <= maxEdge) {
            resolve(sourceUrl);
            return;
          }

          const scale = maxEdge / longestEdge;
          const canvas = document.createElement("canvas");
          canvas.width = Math.max(1, Math.round(image.naturalWidth * scale));
          canvas.height = Math.max(1, Math.round(image.naturalHeight * scale));
          const context = canvas.getContext("2d");
          if (!context) {
            reject(new Error("画像を処理できませんでした"));
            return;
          }
          context.fillStyle = "#ffffff";
          context.fillRect(0, 0, canvas.width, canvas.height);
          context.imageSmoothingEnabled = true;
          context.imageSmoothingQuality = "high";
          context.drawImage(image, 0, 0, canvas.width, canvas.height);
          const outputType =
            file.type === "image/png" ? "image/png" : "image/jpeg";
          resolve(
            outputType === "image/png"
              ? canvas.toDataURL(outputType)
              : canvas.toDataURL(outputType, 0.96),
          );
        };
        image.onerror = () => reject(new Error("画像を読み込めませんでした"));
        image.src = sourceUrl;
      });
    }

    function isHeadingIdentity(paragraph: Element) {
      const significantNodes = Array.from(paragraph.childNodes).filter(
        (node) => node.nodeType !== 3 || Boolean(node.textContent?.trim()),
      );
      return (
        significantNodes.length > 0 &&
        significantNodes.every(
          (node) =>
            node.nodeType === 1 &&
            (node.nodeName === "STRONG" || node.nodeName === "BR"),
        )
      );
    }

    function decorateContactRow(identity: Element) {
      const contactParagraph = identity.nextElementSibling;
      const contactText = contactParagraph?.textContent?.trim() ?? "";
      const looksLikeContact = /@|linkedin|github|email|メール|電話|携帯|phone|tel|website|ポートフォリオ/i.test(
        contactText,
      );
      if (
        !contactParagraph ||
        contactParagraph.tagName !== "P" ||
        !contactText ||
        (!contactParagraph.querySelector("a") && !looksLikeContact)
      )
        return null;
      contactParagraph.querySelectorAll('a[href^="mailto:"]').forEach((link) => {
        link.replaceWith(document.createTextNode(link.textContent ?? ""));
      });
      contactParagraph.querySelectorAll("a").forEach((link) => {
        link.setAttribute("target", "_blank");
        link.setAttribute("rel", "noreferrer");
      });
      contactParagraph.classList.add("resume-contact-row");
      return contactParagraph as HTMLElement;
    }

    function decorateAvatar(source: HTMLElement) {
      const titleHeading = source.querySelector("h1");
      const metaParagraph = titleHeading?.nextElementSibling;
      const parent = titleHeading?.parentElement;
      if (
        !titleHeading ||
        !metaParagraph ||
        metaParagraph.tagName !== "P" ||
        !parent
      )
        return;
      const headingIdentity = isHeadingIdentity(metaParagraph);
      if (headingIdentity)
        metaParagraph.classList.add("resume-heading-identity");
      const contactRow = headingIdentity
        ? decorateContactRow(metaParagraph)
        : null;
      if (!avatarDataUrl && !contactRow) return;

      const coverHeader = document.createElement("div");
      coverHeader.className = "resume-cover-header";

      const lineBreak = metaParagraph.querySelector("br");
      if (!headingIdentity && lineBreak) {
        const name = document.createElement("span");
        name.className = "resume-name";
        let node = lineBreak.nextSibling;
        while (node) {
          const nextNode = node.nextSibling;
          name.append(node);
          node = nextNode;
        }
        metaParagraph.append(name);
      } else if (!headingIdentity) {
        metaParagraph.classList.add("resume-name-only");
      }

      parent.insertBefore(coverHeader, titleHeading);
      coverHeader.append(titleHeading);
      if (contactRow) coverHeader.append(contactRow);

      if (avatarDataUrl) {
        const metaRow = document.createElement("div");
        metaRow.className = "resume-cover-meta";
        const avatarFrame = document.createElement("div");
        avatarFrame.className = "avatar-crop-frame resume-avatar-frame";
        avatarFrame.dataset.shape = avatarShape;
        avatarFrame.style.setProperty(
          "--avatar-zoom",
          String(avatarZoom / 100),
        );
        avatarFrame.style.setProperty(
          "--avatar-offset-x",
          `${avatarOffset.x}%`,
        );
        avatarFrame.style.setProperty(
          "--avatar-offset-y",
          `${avatarOffset.y}%`,
        );
        const avatar = document.createElement("img");
        avatar.className = "resume-avatar";
        avatar.src = avatarDataUrl;
        avatar.alt = message("resumePhotoAlt");
        avatarFrame.append(avatar);
        metaRow.append(metaParagraph, avatarFrame);
        coverHeader.append(metaRow);
      } else {
        coverHeader.append(metaParagraph);
      }
    }

    function paginate(source: HTMLElement, token: number) {
      if (token !== renderToken) return;

      const computed = getComputedStyle(source);
      const contentHeight =
        source.clientHeight -
        px(computed.paddingTop) -
        px(computed.paddingBottom);
      const measuredChildren = Array.from(source.children).map((node) => {
        const child = node as HTMLElement;
        const childStyle = getComputedStyle(child);
        return {
          child,
          height:
            child.getBoundingClientRect().height +
            px(childStyle.marginTop) +
            px(childStyle.marginBottom),
        };
      });

      // Keep headings with the beginning of their section. Major H2 sections
      // also keep the first H3 and its metadata together, so a section title
      // never lands alone at the bottom of a page.
      const measuredBlocks: Array<{
        entries: typeof measuredChildren;
        height: number;
      }> = [];

      for (let index = 0; index < measuredChildren.length; index += 1) {
        const current = measuredChildren[index];
        const isHeading = /^H[1-5]$/.test(current.child.tagName);
        const headingLevel = isHeading
          ? Number(current.child.tagName.slice(1))
          : 0;
        const entries = [current];
        let height = current.height;

        const appendNext = () => {
          const next = measuredChildren[index + 1];
          if (!next) return false;
          entries.push(next);
          height += next.height;
          index += 1;
          return true;
        };

        if (
          headingLevel === 2 &&
          measuredChildren[index + 1]?.child.tagName === "H3"
        ) {
          appendNext();
          if (
            measuredChildren[index + 1] &&
            !/^H[1-5]$/.test(measuredChildren[index + 1].child.tagName)
          ) {
            appendNext();
          }
        } else if (isHeading) {
          const keepFollowing = headingLevel === 2 ? 3 : 1;
          while (
            entries.length <= keepFollowing &&
            measuredChildren[index + 1] &&
            !/^H[1-5]$/.test(measuredChildren[index + 1].child.tagName)
          ) {
            appendNext();
          }
        }

        measuredBlocks.push({ entries, height });
      }

      pages.replaceChildren();

      let currentPage: HTMLElement | undefined;
      let usedHeight = 0;
      let totalPages = 0;

      const addPage = () => {
        const page = document.createElement("section");
        const frame = document.createElement("div");
        frame.className = "resume-page-frame";
        page.className = "resume-page";
        page.setAttribute(
          "aria-label",
          message("pageAriaLabel").replace(
            "{count}",
            String(totalPages + 1),
          ),
        );
        frame.appendChild(page);
        pages.appendChild(frame);
        currentPage = page;
        usedHeight = 0;
        totalPages += 1;
      };

      for (const block of measuredBlocks) {
        if (
          !currentPage ||
          (usedHeight > 0 && usedHeight + block.height > contentHeight)
        ) {
          addPage();
        }

        for (const entry of block.entries) {
          currentPage?.appendChild(entry.child);
        }
        usedHeight += block.height;
      }

      if (!measuredBlocks.length) addPage();

      source.remove();
      const firstPage = pages.querySelector(
        ".resume-page-frame > .resume-page",
      ) as HTMLElement | null;
      if (firstPage) {
        const date = formatCurrentDate();
        const dateElement = document.createElement("time");
        dateElement.className = "resume-date";
        dateElement.dateTime = date;
        dateElement.textContent = date;
        firstPage.appendChild(dateElement);
      }
      currentPageTotal = totalPages || 1;
      pageCount.textContent = formatPageCount(currentPageTotal);
      syncPreviewPageScale();
    }

    function syncPreviewPageScale() {
      const firstPage = pages.querySelector(
        ".resume-page-frame > .resume-page",
      ) as HTMLElement | null;
      if (!firstPage || !previewScroll) return;

      const scrollStyle = getComputedStyle(previewScroll);
      const availableWidth = Math.max(
        0,
        previewScroll.clientWidth -
          px(scrollStyle.paddingLeft) -
          px(scrollStyle.paddingRight),
      );
      const scale = window.matchMedia("(max-width: 1400px)").matches
        ? Math.min(1, availableWidth / firstPage.offsetWidth)
        : 1;

      pages
        .querySelectorAll<HTMLElement>(".resume-page-frame")
        .forEach((frame) => {
          const page = frame.firstElementChild as HTMLElement | null;
          if (!page) return;

          if (scale < 1) {
            frame.style.width = `${page.offsetWidth * scale}px`;
            frame.style.height = `${page.offsetHeight * scale}px`;
            page.style.transform = `scale(${scale})`;
            page.style.transformOrigin = "top left";
          } else {
            frame.style.removeProperty("width");
            frame.style.removeProperty("height");
            page.style.removeProperty("transform");
            page.style.removeProperty("transform-origin");
          }
        });
    }

    function render() {
      const token = ++renderToken;
      const source = document.createElement("div");
      source.className = "resume-page resume-page-measure";
      source.innerHTML = renderMarkdown(textarea.value);
      decorateAvatar(source);
      pages.replaceChildren(source);

      requestAnimationFrame(() => paginate(source, token));
    }

    const previewResizeObserver = new ResizeObserver(syncPreviewPageScale);
    previewResizeObserver.observe(previewScroll);
    window.addEventListener("resize", syncPreviewPageScale);

    function persist() {
      localStorage.setItem(STORAGE_KEY, textarea.value);
    }

    document.addEventListener("keydown", (event) => {
      if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "s") {
        event.preventDefault();
      }
    });

    let debounceTimer: ReturnType<typeof setTimeout>;
    textarea.addEventListener("input", () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        render();
        persist();
      }, 150);
    });

    const saved = localStorage.getItem(STORAGE_KEY);
    textarea.value = saved && saved.trim().length > 0 ? saved : sampleText;
    applyLocale(currentLocale);
    applyTheme(localStorage.getItem(THEME_KEY) ?? "navy");
    applyBackground(localStorage.getItem(BACKGROUND_KEY) ?? "paper");
    syncAvatarEditor();
    render();

    localeButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const nextLocale = button.dataset.localeOption;
        if (!isLocale(nextLocale)) return;
        applyLocale(nextLocale);
        localStorage.setItem(LOCALE_KEY, nextLocale);
      });
    });

    themeButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const nextTheme = button.dataset.themeOption ?? "navy";
        applyTheme(nextTheme);
        localStorage.setItem(THEME_KEY, nextTheme);
      });
    });

    backgroundButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const nextBackground = button.dataset.backgroundOption ?? "paper";
        applyBackground(nextBackground);
        localStorage.setItem(BACKGROUND_KEY, nextBackground);
      });
    });

    document.getElementById("load-sample")?.addEventListener("click", () => {
      if (!confirm(message("loadSampleConfirm"))) return;
      textarea.value = sampleText;
      render();
      persist();
    });

    document.getElementById("clear-editor")?.addEventListener("click", () => {
      if (!confirm(message("clearConfirm"))) return;
      textarea.value = "";
      render();
      persist();
    });

    document.getElementById("save-pdf")?.addEventListener("click", () => {
      window.print();
    });

    document.getElementById("save-md")?.addEventListener("click", () => {
      const blob = new Blob([textarea.value], {
        type: "text/markdown;charset=utf-8",
      });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = "resume.md";
      a.click();
      URL.revokeObjectURL(url);
    });

    document
      .getElementById("download-sample")
      ?.addEventListener("click", () => {
        const blob = new Blob([sampleText], {
          type: "text/markdown;charset=utf-8",
        });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = "sample-resume.md";
        a.click();
        URL.revokeObjectURL(url);
      });

    const fileInput = document.getElementById("file-input") as HTMLInputElement;
    fileInput.addEventListener("change", () => {
      const file = fileInput.files?.[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = () => {
        textarea.value = String(reader.result ?? "");
        render();
        persist();
      };
      reader.readAsText(file);
      fileInput.value = "";
    });

    avatarInput.addEventListener("change", async () => {
      const file = avatarInput.files?.[0];
      avatarInput.value = "";
      if (!file) return;
      try {
        const nextAvatar = await optimizeAvatar(file);
        setAvatarEditorOpen(true, nextAvatar);
        updateAvatarControls("avatarPending");
      } catch {
        updateAvatarControls("avatarUploadFailed");
      }
    });

    clearAvatarButton.addEventListener("click", () => {
      localStorage.removeItem(AVATAR_KEY);
      localStorage.setItem(AVATAR_DEFAULT_DISMISSED_KEY, "true");
      avatarDataUrl = "";
      setAvatarEditorOpen(false);
      updateAvatarControls();
      render();
    });

    editAvatarButton.addEventListener("click", () => {
      setAvatarEditorOpen(true);
    });

    closeAvatarEditorButton.addEventListener("click", () => {
      setAvatarEditorOpen(false);
    });

    cancelAvatarEditorButton.addEventListener("click", () => {
      setAvatarEditorOpen(false);
    });

    saveAvatarEditorButton.addEventListener("click", () => {
      saveAvatarEditor();
    });

    avatarEditor.addEventListener("click", (event) => {
      if (event.target === avatarEditor) setAvatarEditorOpen(false);
    });

    avatarEditor.addEventListener("cancel", (event) => {
      event.preventDefault();
      setAvatarEditorOpen(false);
    });

    avatarZoomInput.addEventListener("input", () => {
      avatarDraftZoom = Math.min(
        240,
        Math.max(100, Number(avatarZoomInput.value)),
      );
      syncAvatarEditor();
    });

    avatarShapeInputs.forEach((input) => {
      input.addEventListener("change", () => {
        if (
          input.checked &&
          (input.value === "square" || input.value === "circle")
        ) {
          avatarDraftShape = input.value;
          syncAvatarEditor();
        }
      });
    });
  </script>
</Layout>
