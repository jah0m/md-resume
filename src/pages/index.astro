---
import Layout from "../layouts/Layout.astro";
import "../styles/resume.css";
import sampleResume from "../data/sample-resume.md?raw";
import ThemeControls from "../components/ThemeControls.astro";
import FontPicker from "../components/FontPicker.astro";
import RirekishoEditor from "../components/RirekishoEditor.astro";
import PhotoEditorDialog from "../components/PhotoEditorDialog.astro";

const title = "Markdown職務経歴書 PDF変換ツール｜無料・ブラウザで完結";
const description =
  "日本の定番テンプレートでは物足りない人へ。Markdownで書いた職務経歴書を、デザイン性のあるA4レイアウトに整えてPDF保存できます。入力内容はブラウザ内だけで処理します。";
---

<Layout title={title} description={description}>
  <div class="app" id="resume-studio" data-view="edit">
    <header class="app-header">
      <div class="header-row">
        <div class="app-title-wrap">
          <div class="brand-lockup">
            <img
              class="brand-mark"
              src="/favicon.svg"
              alt=""
              aria-hidden="true"
            />
            <div>
              <p class="eyebrow">PERSONAL RESUME STUDIO</p>
              <h1 data-i18n="brandTitle">型にはまらない、あなたの職務経歴書</h1>
            </div>
          </div>
          <p class="lede" data-i18n="lede">
            Markdownで書いて、自分のキャリアを自分で設計する。
          </p>
        </div>
        <div class="header-meta">
          <span class="privacy-note" data-i18n="privacyNote"
            >データはブラウザ内だけで処理</span
          >
          <span class="header-detail" data-i18n="headerDetail"
            >A4 / Markdown → PDF</span
          >
          <div
            class="language-picker"
            role="group"
            aria-label="表示言語"
            data-i18n-aria-label="languageLabel"
          >
            <div class="language-options">
              <button type="button" data-locale-option="ja" aria-pressed="true"
                >日</button
              >
              <button type="button" data-locale-option="en" aria-pressed="false"
                >EN</button
              >
              <button type="button" data-locale-option="zh" aria-pressed="false"
                >中</button
              >
            </div>
          </div>
        </div>
      </div>
    </header>

    <nav class="document-switcher" role="tablist" aria-label="書類の種類">
      <button id="career-tab" type="button" role="tab" aria-selected="true" aria-controls="career-workspace" data-document="career" data-i18n="careerDocument">職務経歴書</button>
      <button id="personal-tab" type="button" role="tab" aria-selected="false" aria-controls="personal-workspace" tabindex="-1" data-document="personal" data-i18n="personalDocument">履歴書</button>
    </nav>

    <div id="career-workspace" class="workspace" role="tabpanel" aria-labelledby="career-tab">
      <div class="editor-pane">
        <nav class="editor-outline" aria-labelledby="editor-outline-title">
          <div class="editor-outline-heading">
            <span
              id="editor-outline-title"
              class="editor-outline-label"
              data-i18n="outlineTitle">Markdown構成</span
            >
            <span id="editor-outline-count" class="editor-outline-count">0</span
            >
          </div>
          <div id="editor-outline-list" class="editor-outline-list"></div>
        </nav>
        <div class="panel-heading">
          <div>
            <div class="pane-label">
              <span data-i18n="editorPaneLabel">原稿エディター</span>
              <span data-i18n="autosave">自動保存</span>
            </div>
            <p class="panel-title" data-i18n="editorTitle">
              Markdownで内容を整える
            </p>
          </div>
          <span class="panel-index">01</span>
        </div>
        <div class="editor-toolbar">
          <div class="action-group">
            <button id="load-sample" data-i18n="loadSample">サンプル</button>
            <button id="download-sample" data-i18n="downloadSample"
              >サンプルを保存</button
            >
            <label for="file-input" data-i18n="openMd">.mdを開く</label>
            <input
              id="file-input"
              type="file"
              accept=".md,text/markdown,text/plain"
            />
          </div>
          <div class="action-group action-group-secondary">
            <button id="save-md" data-i18n="saveMd">.md保存</button>
            <button id="clear-editor" data-i18n="clear">クリア</button>
          </div>
        </div>
        <div class="avatar-control">
          <div class="avatar-control-copy">
            <span class="avatar-control-label" data-i18n="profilePhoto"
              >プロフィール写真</span
            >
            <span id="avatar-status">未設定</span>
          </div>
          <div class="avatar-control-actions">
            <label for="avatar-input" data-i18n="uploadImage"
              >画像をアップロード</label
            >
            <button
              id="edit-avatar"
              type="button"
              disabled
              data-i18n="editPhoto">写真を編集</button
            >
            <button
              id="clear-avatar"
              type="button"
              disabled
              data-i18n="removePhoto">取り除く</button
            >
            <input id="avatar-input" type="file" accept="image/*" />
          </div>
        </div>
        <PhotoEditorDialog />
        <div class="editor-input-wrap" id="editor-input-wrap">
          <textarea
            id="markdown-input"
            spellcheck="false"
            aria-label="Markdown入力"
            data-i18n-aria-label="editorInput"></textarea>
          <button
            id="insert-spacer"
            class="editor-spacer-trigger"
            type="button"
            hidden
            aria-label="余白を追加"
            data-i18n-aria-label="insertSpacer"
            title="余白を追加"
            data-i18n-title="insertSpacer">+</button
          >
        </div>
      </div>
      <div class="preview-pane">
        <div class="panel-heading">
          <div>
            <div class="pane-label">
              <div class="pane-label-start">
                <span data-i18n="previewLabel">プレビュー</span>
                <label class="date-toggle" for="show-date">
                  <input id="show-date" type="checkbox" checked />
                  <span data-i18n="showDate">日付を表示</span>
                </label>
                <label class="name-align-switch" id="name-align-label" for="name-align">
                  <span data-i18n="nameAlign">氏名の位置</span>
                  <input id="name-align" type="checkbox" role="switch" checked />
                  <span class="name-align-track">
                    <span data-i18n="nameAlignLeft">左</span>
                    <span data-i18n="nameAlignRight">右</span>
                  </span>
                </label>
              </div>
              <span id="page-count">A4 / Professional</span>
            </div>
            <p
              id="content-overflow-warning"
              class="preview-warning"
              role="status"
              hidden
              data-i18n="contentOverflow"
            >
              1ページに収まらない段落や項目があり、はみ出した部分はPDFに出力されません。分割してください。
            </p>
          </div>
          <div class="preview-actions">
            <ThemeControls />
            <details class="page-margin-picker" id="page-margin-picker">
              <summary id="page-margin-summary">余白 15/15 mm</summary>
              <div class="page-margin-controls">
                <label class="page-margin-control" for="page-margin-top">
                  <span>
                    <span data-i18n="topMargin">上</span>
                    <output id="page-margin-top-value">15 mm</output>
                  </span>
                  <input
                    id="page-margin-top"
                    type="range"
                    min="0"
                    max="24"
                    step="1"
                    value="15"
                  />
                </label>
                <label class="page-margin-control" for="page-margin-bottom">
                  <span>
                    <span data-i18n="bottomMargin">下</span>
                    <output id="page-margin-bottom-value">15 mm</output>
                  </span>
                  <input
                    id="page-margin-bottom"
                    type="range"
                    min="0"
                    max="24"
                    step="1"
                    value="15"
                  />
                </label>
                <button
                  id="reset-page-margins"
                  type="button"
                  data-i18n="resetMargins">初期値に戻す</button
                >
              </div>
            </details>
            <FontPicker />
            <button id="save-pdf" class="primary" data-i18n="savePdf"
              >PDFとして保存</button
            >
          </div>
        </div>
        <div class="preview-scroll">
          <article
            id="resume-preview"
            aria-label="職務経歴書プレビュー"
            data-i18n-aria-label="resumePreview"
          >
            <div id="resume-pages"></div>
          </article>
        </div>
      </div>
      <section class="usage-section">
        <h2 data-i18n="aboutTitle">このツールについて</h2>
        <p data-i18n="aboutText">
          日本の定番テンプレートでは表現しにくい、自分らしさとキャリアの個性を、Markdownから自分で組み立てられる職務経歴書に。
          入力した内容はデザイン性のあるA4レイアウトに整形され、サーバーに送信されることなくブラウザ内で処理されます。
          「PDFとして保存」ボタンのクリック数のみ匿名で集計し、入力内容は送信しません。
        </p>
        <h2 data-i18n="howToTitle">使い方</h2>
        <ol>
          <li data-i18n="howToStep1">
            「サンプルを読み込む」でMarkdownの書き方を確認するか、お手持ちの.mdファイルを開きます。
          </li>
          <li data-i18n="howToStep2">
            Markdownを編集すると、プレビューに反映されます。
          </li>
          <li data-i18n="howToStep3">
            「PDFとして保存」を押すと印刷ダイアログが開きます。出力先を「PDFに保存」にして保存すれば完了です。
          </li>
        </ol>
        <div class="usage-ai-prompt">
          <div class="usage-ai-prompt-heading">
            <span class="usage-ai-prompt-kicker">AI PROMPT</span>
          </div>
          <p id="ai-prompt-text" data-i18n="aiPrompt">
            このサンプルの見出しと構成に合わせて、私の職務経歴書をMarkdownとして整理してください。内容は変更せず、情報が足りない部分は「〇〇」などのプレースホルダーにしてください。
          </p>
          <button id="copy-ai-prompt" type="button" data-i18n="copyPrompt"
            >Promptをコピー</button
          >
        </div>
        <div class="usage-contact-tip">
          <strong data-i18n="contactTitle">連絡先の書き方</strong>
          <p data-i18n-html="contactHelp">
            名前の直後に1行で記述すると、タイトル下に表示されます。<strong
              >PhoneとEmail</strong
            >はテキスト、<strong
              >LinkedIn・GitHub・Portfolio・個人サイト・SNS</strong
            >などはMarkdownリンクにします。
          </p>
        </div>
        <h2 data-i18n="syntaxTitle">対応記法</h2>
        <p data-i18n="syntaxText">
          見出し（# ##
          ###）、箇条書き、表、太字などの標準的なMarkdown記法に対応しています。
        </p>
        <div class="usage-spacer-tip">
          <strong data-i18n="spacerTitle">余白の調整</strong>
          <p data-i18n="spacerHelp">
            Markdownの単独行にこの記法を追加すると、本文約1行分の間隔が入ります。
          </p>
          <code class="usage-spacer-code">&lt;!-- spacer --&gt;</code>
        </div>
        <div class="usage-font-license">
          <a
            id="font-license"
            href="/font-licenses.txt"
            target="_blank"
            rel="noopener"
            data-i18n="fontLicense">使用フォントとライセンス（SIL OFL 1.1）</a
          >
        </div>
        <footer class="site-footer">
          <a href="https://github.com/jah0m" target="_blank" rel="noreferrer"
            >© Jahom</a
          >
        </footer>
      </section>
    </div>
    <RirekishoEditor />
    <div class="mobile-action-bar">
      <div
        class="mobile-view-switch"
        role="group"
        aria-label="表示の切り替え"
        data-i18n-aria-label="viewSwitchLabel"
      >
        <button type="button" data-view-option="edit" aria-pressed="true" data-i18n="viewEdit">編集</button>
        <button type="button" data-view-option="preview" aria-pressed="false" data-i18n="viewPreview">プレビュー</button>
      </div>
      <button id="mobile-print" type="button" data-i18n="savePdf">PDFとして保存</button>
    </div>
  </div>

  <script type="text/plain" id="sample-resume-data" set:html={sampleResume} />

  <script>import "../lib/workbench";</script>
</Layout>
